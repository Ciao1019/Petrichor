# HTTP
HTTP_ADDR=":8080"
APP_ENV="development"
APP_BASE_URL="http://localhost:3000"

# Supabase / PostgreSQL
DATABASE_URL="postgres://postgres:[password]@[host]:5432/postgres"

# Session（Go API 自主管理 httpOnly Cookie）
PETRICHOR_SESSION_COOKIE_NAME="petrichor_session"
PETRICHOR_SESSION_EXPIRE_SECONDS="172800"

# 注册策略
PETRICHOR_REGISTER_ENABLED="false"
PETRICHOR_REGISTER_DEFAULT_SYSTEM_ROLE="USER"

# API key 加解密（迁移 AI 配置时使用）
PETRICHOR_ENCRYPT_KEY="replace-with-stable-random-secret"
PETRICHOR_ENCRYPT_SALT="replace-with-16-hex-chars"

# S3 兼容对象存储（可选；不配则可用本地目录）
# S3_ENDPOINT=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=
# PETRICHOR_STORAGE_DIR=./.local-storage

# Upstash Redis（可选）
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# LinuxDo OAuth
# PETRICHOR_LINUXDO_CLIENT_ID=
# PETRICHOR_LINUXDO_CLIENT_SECRET=
# PETRICHOR_LINUXDO_REDIRECT_URI=http://localhost:3000/api/auth/callback

# PDF sidecar
PETRICHOR_PDF_INSPECTOR_URL="http://127.0.0.1:8091"
