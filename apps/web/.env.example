# 仅供 Bun/Vite 前端使用；Go 后端配置请填写 apps/api/config.toml。

# 浏览器可见配置
PETRICHOR_PUBLIC_REGISTER_ENABLED="false"

# Bun 前端服务把 /api/* 同源转发到这里。
PETRICHOR_GO_API_URL="http://127.0.0.1:8080"

# 可选：Giscus 评论
PETRICHOR_PUBLIC_GISCUS_REPO=""
PETRICHOR_PUBLIC_GISCUS_REPO_ID=""
PETRICHOR_PUBLIC_GISCUS_CATEGORY=""
PETRICHOR_PUBLIC_GISCUS_CATEGORY_ID=""
