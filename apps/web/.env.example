# Supabase / PostgreSQL
DATABASE_URL="postgres://postgres:[password]@[host]:5432/postgres"
# 可选：Vercel 生产迁移专用的直连或 session pooler URL；未设置时回退到 DATABASE_URL
MIGRATION_DATABASE_URL=""

# Better Auth session
SESSION_SECRET="replace-with-at-least-32-characters"
PETRICHOR_SESSION_EXPIRE_SECONDS="172800"

# API key encryption for AI model configs
PETRICHOR_ENCRYPT_KEY="replace-with-stable-random-secret"
PETRICHOR_ENCRYPT_SALT="replace-with-16-hex-chars"

# S3-compatible object storage
S3_ENDPOINT="https://s3.example.com"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="your-access-key-id"
S3_SECRET_ACCESS_KEY="your-secret-access-key"
S3_BUCKET="your-bucket"
S3_UPLOAD_EXPIRE_SECONDS="900"
S3_DOWNLOAD_EXPIRE_SECONDS="3600"
S3_USE_SSL="true"

# UI
NEXT_PUBLIC_REGISTER_ENABLED="false"
PETRICHOR_REGISTER_DEFAULT_SYSTEM_ROLE="USER"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional LinuxDo OAuth
PETRICHOR_LINUXDO_CLIENT_ID=""
PETRICHOR_LINUXDO_CLIENT_SECRET=""
PETRICHOR_LINUXDO_REDIRECT_URI=""

# Optional Upstash Redis shared cache
# (public article list/detail, about, projects, site appearance, doc-library lists & document content)
# Leave empty to disable caching — the app falls back to the Next.js data cache and works unchanged.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ===== Go 后端（apps/api，可选）=====
# 设置后 /api 请求按前缀分流到 Go 服务（绞杀者迁移）；留空保持原 Node 行为。
# PETRICHOR_GO_API_URL="http://127.0.0.1:8080"
# 逗号分隔的路径前缀；默认整个 /api。例如先迁公开接口：
# PETRICHOR_GO_API_PREFIXES="api/public,api/notification"
