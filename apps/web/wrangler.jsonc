{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "petrichor",
    "main": ".open-next/worker.js",
    "compatibility_date": "2025-03-25",
    // nodejs_compat：启用 Workers 的 Node.js 兼容层（postgres.js、Buffer、crypto 等依赖它）
    // global_fetch_strictly_public：OpenNext 要求，保证 fetch 走公网而非内部路由
    "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
    "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
    },
    "observability": {
        "enabled": true
    }
    // ── 可选增强（按需取消注释并在 open-next.config.ts 中启用）────────────
    // 增量缓存（ISR / fetch 缓存）需要一个 R2 桶：
    // "r2_buckets": [
    //     { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "petrichor-cache" }
    // ]
}
