# 本地 HTTP 使用 :80；生产域名填写 example.com，Caddy 会自动签发 HTTPS 证书。
PETRICHOR_DOMAIN=:80
PETRICHOR_HTTP_PORT=80
PETRICHOR_HTTPS_PORT=443
PETRICHOR_REDIS_PORT=6379
PETRICHOR_REDIS_MAXMEMORY=1gb
# asynqmon 无业务认证，因此只绑定宿主机回环地址。
PETRICHOR_ASYNQMON_PORT=8081
PETRICHOR_GOPROXY=https://proxy.golang.org,direct
# 默认拉取 GHCR 多架构镜像；也可改为 master 或 sha-<12 位提交哈希> 标签。
PETRICHOR_API_IMAGE=ghcr.io/ciao1019/petrichor-api:latest
PETRICHOR_WEB_IMAGE=ghcr.io/ciao1019/petrichor-web:latest
