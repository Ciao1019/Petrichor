{
  "name": "petrichor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build",
    "build:demo": "bun run --cwd apps/web build:demo",
    "build:api": "cd apps/api && go build ./...",
    "start": "bun run --cwd apps/web start",
    "lint": "bun run --cwd apps/web lint",
    "test": "bun run --cwd apps/web test",
    "test:coverage": "bun run --cwd apps/web test:coverage",
    "test:api": "cd apps/api && go test ./...",
    "audit:web": "bun run --cwd apps/web audit",
    "check:bundle": "bun run --cwd apps/web check:bundle",
    "check:size": "./scripts/check-file-size.sh",
    "typecheck": "bun run --cwd apps/web typecheck",
    "typecheck:demo": "bun run --cwd apps/web typecheck:demo",
    "typecheck:api-strict": "bun run --cwd apps/web typecheck:api-strict"
  },
  "engines": {
    "bun": ">=1.3.14"
  }
}
